{
  "swagger": "2.0",


  "info": {
    "version": "1.0.0",
    "title": "HR Management System API",
    "description": "API documentation for the HR management system"
  },

  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://iro-employee-bn.onrender.com/",
      "description": "Production server (HTTPS)"
    }
  ],


  "schemes":  ["http", "https"],

  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your bearer token in the format **Bearer <token>**"
    }
  },
  "security": [{ "Bearer": [] }],

 

  "paths": {

    
    "/auth/register": {
      "post": {
        "summary": "Register a new HR user",
        "description": "Register a new HR user with details such as name, email, and password.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "supervisorId": { "type": "string" },
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "position": { "type": "string" },
                "gender": { "type": "string" },
                "telephone": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["email", "password"]
            }
          }
        ],
        "responses": {
          "202": {
            "description": "User successfully registered"
          },
          "400": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "description": "Logs in a user and returns a token for authentication.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["email", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful, returns user data and token"
          },
          "404": {
            "description": "Invalid username"
          },
          "300": {
            "description": "Account locked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
   "/employee/{id}/make-admin": {
      "put": {
        "summary": "Make User an Admin",
        "description": "Updates a user's role to Admin.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the user to be made an admin.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully made an admin.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Success full user made as an admin"
                }
              }
            }
          },
          "400": {
            "description": "User not found or invalid ID.",
            "content": {
              "application/json": {
                "example": {
                  "message": "User not made admin"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Internal server error",
                  "error": "Detailed error message"
                }
              }
            }
          }
        }
      }
    },
    "/employee/{id}/make-supervisor": {
      "put": {
        "summary": "Make User a Supervisor",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "User ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully made a supervisor."
          },
          "400": {
            "description": "Invalid ID format or user not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },
    "/employee/:id/remove-privillage": {
      "patch": {
        "summary": "Revoke user privileges",
        "description": "Revokes a user's admin or supervisor privileges.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User privileges successfully revoked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employee/:id/lock": {
      "patch": {
        "summary": "Lock user account",
        "description": "Locks a user's account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User account successfully locked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employee/:id/unlock": {
      "patch": {
        "summary": "Unlock user account",
        "description": "Unlocks a user's account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User account successfully unlocked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },

    "/getAll/employee": {
      "get": {
        "summary": "Retrieve all employees",
        "description": "Fetch a list of all employees with the role 'Employee'.",
        "responses": {
          "202": {
            "description": "Employees found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Employee found"
                    },
                    "employees": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": { "type": "string", "example": "123456" },
                          "firstName": { "type": "string", "example": "John" },
                          "lastName": { "type": "string", "example": "Doe" },
                          "email": { "type": "string", "example": "john.doe@example.com" },
                          "role": { "type": "string", "example": "Employee" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },
   "/get/employee/{id}": {
    "get": {
      "summary": "Retrieve an Employee by ID",
      "description": "Fetch the details of a specific employee using their unique ID.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The unique ID of the employee to retrieve.",
          "schema": {
            "type": "string",
            "example": "673da141a46d15dbf533f4bb"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Employee found successfully.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string", "example": "Employee found" },
                  "employee": {
                    "type": "object",
                    "properties": {
                      "_id": { "type": "string", "example": "673da141a46d15dbf533f4bb" },
                      "firstName": { "type": "string", "example": "John" },
                      "lastName": { "type": "string", "example": "Doe" },
                      "email": { "type": "string", "example": "john.doe@example.com" },
                      "role": { "type": "string", "example": "Supervisor" }
                    }
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "Employee not found.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string", "example": "No User found or check employee ID" }
                }
              }
            }
          }
        },
        "500": {
          "description": "Internal server error.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string", "example": "Internal server error" },
                  "error": { "type": "string", "example": "Error details." }
                }
              }
            }
          }
        }
      }
    }
  },

  "/leave-requests/{id}/cancel": {
    "put": {
      "summary": "Cancel a Leave Request",
      "description": "Allows a user to cancel their leave request. A token must be provided in the Authorization header.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The ID of the leave request to cancel.",
          "schema": {
            "type": "string",
            "example": "64a6f9ec6fc6193af12c3a9f"
          }
        },
        {
          "name": "Authorization",
          "in": "header",
          "required": true,
          "description": "Bearer token for user authentication.",
          "schema": {
            "type": "string",
            "example": "Bearer your_token_here"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Leave request canceled successfully.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Leave request successfully canceled before starting."
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Bad request or leave request cannot be canceled.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Leave request ID is required."
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "User or leave request not found.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "No user found."
                  }
                }
              }
            }
          }
        },
        "500": {
          "description": "Internal server error.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Internal server error."
                  },
                  "error": {
                    "type": "string",
                    "example": "Error details."
                  }
                }
              }
            }
          }
        }
      }
    }
  },



    
 "/leave-requests/employee/{employeeId}": {
    "get": {
      "summary": "View Leave Request by Employee",
      "description": "Fetch a specific leave request for an employee using their unique employee ID.",
      "parameters": [
        {
          "name": "employeeId",
          "in": "path",
          "required": true,
          "description": "The unique ID of the employee whose leave request you want to view.",
          "schema": {
            "type": "string",
            "example": "64a6f9ec6fc6193af12c3a9f"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Leave request retrieved successfully.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Success"
                  },
                  "request": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "example": "64a6f9ec6fc6193af12c3a9f"
                      },
                      "employeeId": {
                        "type": "string",
                        "example": "64a6f9ec6fc6193af12c3a9f"
                      },
                      "status": {
                        "type": "string",
                        "example": "Approved"
                      },
                      "startDate": {
                        "type": "string",
                        "format": "date",
                        "example": "2024-12-01"
                      },
                      "endDate": {
                        "type": "string",
                        "format": "date",
                        "example": "2024-12-10"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "Request not found.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Request not found"
                  }
                }
              }
            }
          }
        },
        "500": {
          "description": "Internal server error.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Internal server error"
                  },
                  "error": {
                    "type": "string",
                    "example": "Error details"
                  }
                }
              }
            }
          }
        }
      }
    }
  },






