          {
            "in": "query",
            "name": "userId",
            "required": true,
            "type": "string",
            "description": "The ID of the user making the leave request"
          },
          {
            "in": "query",
            "name": "leaveTypeId",
            "required": true,
            "type": "string",
            "description": "The ID of the leave type being requested"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "description": "Leave request details",
            "schema": {
              "type": "object",
              "properties": {
                "leaveTypeId": {
                  "type": "string",
                  "example": "67498c07f144d312c44773cd"
                },
                "description": {
                  "type": "string",
                  "example": "Annual leave"
                },
                "startDate": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-12-10"
                },
                "endDate": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-12-15"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leave request successfully created",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Leave request successfully created"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
