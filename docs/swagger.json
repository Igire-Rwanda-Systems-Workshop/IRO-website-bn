   "/addLeaveType": {
  "post": {
    "summary": "Add a New Leave Type",
    "description": "Create a new leave type.",
    "parameters": [
      {
        "name": "body",
        "in": "body",
        "description": "Leave type details to be added.",
        "required": true,
          "schema": {
            "type": "object",
            "properties": {
                  "leaveType": {
                    "type": "string",
                    "description": "The name of the leave type (e.g., Annual Leave)."
                  },
                  "description": {
                    "type": "string",
                    "description": "A brief description of the leave type."
                  },
                  "daysAllowed": {
                    "type": "integer",
                    "description": "The maximum number of days allowed for this leave type."
                  }
                },
                "required": ["leaveType", "description", "daysAllowed"]
              }
            }
    ],
    "responses": {
      "202": {
        "description": "Leave type added successfully."
      },
    "400":{
      "description": "Invalid request."
    },
    "500": {
      "description": "Internal server error."
      }
    }
  }
     
},


