"/forget-password": {
  "post": {
    "summary": "incase you forgot your password",
    "description": "if you forgot your password",
    "tags": ["User-Auth"],
    "parameters": [
      {
        "in": "body",
        "name": "body",
        "schema": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "example": "john.doe@example.com"
            }
