{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "HR Management System API",
    "description": "API documentation for the HR management system"
  },
  "host": "localhost:3000",
  "basePath": "/api",
  "schemes": ["http"],
  "paths": {
    "/register": {
      "post": {
        "summary": "Register a new HR user",
        "description": "Register a new HR user with details such as name, email, and password.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "supervisorId": { "type": "string" },
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "position": { "type": "string" },
                "gender": { "type": "string" },
                "telephone": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["email", "password"]
            }
          }
        ],
        "responses": {
          "202": {
            "description": "User successfully registered"
          },
          "400": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login user",
        "description": "Logs in a user and returns a token for authentication.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["email", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful, returns user data and token"
          },
          "404": {
            "description": "Invalid username"
          },
          "300": {
            "description": "Account locked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/{id}/make-admin": {
      "patch": {
        "summary": "Make user an admin",
        "description": "Grants admin privileges to a user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully made admin"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/{id}/make-supervisor": {
      "patch": {
        "summary": "Make user a supervisor",
        "description": "Assigns a user the supervisor role.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully made supervisor"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/{id}/revoke-privileges": {
      "patch": {
        "summary": "Revoke user privileges",
        "description": "Revokes a user's admin or supervisor privileges.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User privileges successfully revoked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/{id}/lock-account": {
      "patch": {
        "summary": "Lock user account",
        "description": "Locks a user's account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User account successfully locked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/{id}/unlock-account": {
      "patch": {
        "summary": "Unlock user account",
        "description": "Unlocks a user's account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User account successfully unlocked"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },

    "/api/employees": {
      "get": {
        "summary": "Retrieve all employees",
        "description": "Fetch a list of all employees with the role 'Employee'.",
        "responses": {
          "202": {
            "description": "Employees found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Employee found"
                    },
                    "employees": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": { "type": "string", "example": "123456" },
                          "firstName": { "type": "string", "example": "John" },
                          "lastName": { "type": "string", "example": "Doe" },
                          "email": { "type": "string", "example": "john.doe@example.com" },
                          "role": { "type": "string", "example": "Employee" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/employees/{id}": {
      "get": {
        "summary": "Retrieve an employee by ID",
        "description": "Fetch details of a specific employee using their unique ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the employee to retrieve",
            "schema": {
              "type": "string",
              "example": "123456"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Employee found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Employee found" },
                    "employee": {
                      "type": "object",
                      "properties": {
                        "_id": { "type": "string", "example": "123456" },
                        "firstName": { "type": "string", "example": "John" },
                        "lastName": { "type": "string", "example": "Doe" },
                        "email": { "type": "string", "example": "john.doe@example.com" },
                        "role": { "type": "string", "example": "Employee" }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Employee not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "No User found or check employee id" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/api/leave/cancel/{id}": {
      "put": {
        "summary": "Cancel leave request",
        "description": "Allows an employee to cancel their leave request.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the leave request to be canceled.",
            "schema": {
              "type": "string",
              "example": "60a6f9ec6fc6193af12c3a9e"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leave request canceled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Leave request successfully canceled during the leave period"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Cannot cancel leave",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Cannot cancel a leave request that has already ended" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User or leave request not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "No user found" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/leave/view/{employeeId}": {
      "get": {
        "summary": "View leave request by employee",
        "description": "Allows an employee to view their leave request.",
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "description": "The employee's ID to view their leave request.",
            "schema": {
              "type": "string",
              "example": "60a6f9ec6fc6193af12c3a9f"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leave request retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Success" },
                    "request": { "type": "object", "example": { "_id": "123456", "status": "Approved" } }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Request not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Request not found" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/leave/summary": {
      "get": {
        "summary": "Get leave request summary",
        "description": "Provides a summary of leave requests by their statuses.",
        "responses": {
          "200": {
            "description": "Summary of leave requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pending": { "type": "integer", "example": 10 },
                    "approved": { "type": "integer", "example": 5 },
                    "denied": { "type": "integer", "example": 2 }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Internal server error" },
                    "error": { "type": "string", "example": "Error details" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/leave-types": {
      "get": {
        "summary": "Get All Leave Types",
        "description": "Retrieve all leave types.",
        "responses": {
          "200": {
            "description": "Successfully retrieved leave types.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Successfull",
                  "leaveTypes": [
                    {
                      "id": "12345",
                      "leaveType": "Annual Leave",
                      "description": "Leave for vacation purposes"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Add a New Leave Type",
        "description": "Create a new leave type.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "id": "12345",
                "leaveType": "Annual Leave",
                "description": "Leave for vacation purposes"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leave type added successfully.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Leave type added successfully",
                  "status": "Success",
                  "data": {
                    "id": "12345",
                    "leaveType": "Annual Leave",
                    "description": "Leave for vacation purposes"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request or duplicate leave type."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/leave-types/{id}": {
      "get": {
        "summary": "Get Leave Type By ID",
        "description": "Retrieve a specific leave type by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the leave type to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Leave type found.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Leave type found",
                  "leaveType": {
                    "id": "12345",
                    "leaveType": "Annual Leave",
                    "description": "Leave for vacation purposes"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Leave type not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "summary": "Update Leave Type",
        "description": "Update an existing leave type by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the leave type to update."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "leaveType": "Sick Leave",
                "description": "Leave for medical purposes"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leave type updated successfully.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Leave type updated successfully",
