    "/leave/viewAllRequests": {
      "get": {
        "summary": "View all leave requests",
        "description": "Retrieve all leave requests from the database.",
        "tags": ["Leave Requests"],
        "responses": {
          "200": {
            "description": "Successfully retrieved leave requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "leaveRequests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LeaveRequest"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/leave/sendRequest": {
      "post": {
        "summary": "Send a leave request",
        "description": "Create a new leave request.",
        "tags": ["Leave Requests"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "leaveTypeId": { "type": "string" },
                  "description": { "type": "string" },
                  "startDate": { "type": "string", "format": "date" },
                  "endDate": { "type": "string", "format": "date" }
                },
                "required": ["leaveTypeId", "description", "startDate", "endDate"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request sent successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Leave days exceeded"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/leave/confirmRequest/{id}": {
      "patch": {
        "summary": "Approve a leave request",
        "description": "Approve a leave request by its ID.",
        "tags": ["Leave Requests"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the leave request",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leave request approved"
          },
          "404": {
            "description": "Leave request not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/leave/denyRequest/{id}": {
      "patch": {
        "summary": "Deny a leave request",
        "description": "Deny a leave request by its ID.",
        "tags": ["Leave Requests"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the leave request",
            "schema": {
              "type": "string"
